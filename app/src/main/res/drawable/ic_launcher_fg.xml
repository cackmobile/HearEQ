<?xml version="1.0" encoding="utf-8"?>
<!-- Red circle-A (anarchy symbol), kept inside the adaptive icon's 66dp safe zone -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
    <!-- circle -->
    <path
        android:pathData="M54,30a24,24 0,1 1,0 48a24,24 0,1 1,0 -48z"
        android:strokeColor="#E0211B"
        android:strokeWidth="4.5"
        android:fillColor="#00000000" />
    <!-- A legs, breaking out above and below the circle -->
    <path
        android:pathData="M40,83L54,22L68,83"
        android:strokeColor="#E0211B"
        android:strokeWidth="5"
        android:strokeLineJoin="miter"
        android:strokeLineCap="square"
        android:fillColor="#00000000" />
    <!-- crossbar, breaking out either side -->
    <path
        android:pathData="M28,61L80,61"
        android:strokeColor="#E0211B"
        android:strokeWidth="5"
        android:strokeLineCap="square" />
</vector>
